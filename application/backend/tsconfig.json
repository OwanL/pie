{
  "//": "Typecheck gate for the application backend owners (B7). `module: preserve` + `moduleResolution: bundler` allow `import.meta` and `.js`-extension imports. Backend sources use their application owners and the canonical application/lib/protocol and harness RPC contracts. Analytics-owned analytics-views sources/tests and the composition analytics-runtime test stay typechecked by analytics/tsconfig.json.",
  "compilerOptions": {
    "target": "ES2021",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "../hosts/vscode/node_modules/.cache/typecheck/application-backend.tsbuildinfo",
    "types": ["node", "vscode"],
    "typeRoots": ["../hosts/vscode/node_modules/@types", "../hosts/vscode/node_modules"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "yaml": ["../hosts/vscode/node_modules/yaml"],
      "ajv": ["../hosts/vscode/node_modules/ajv"],
      "immer": ["../hosts/vscode/node_modules/immer"],
      "preact": ["../hosts/vscode/node_modules/preact"],
      "preact-render-to-string": ["../hosts/vscode/node_modules/preact-render-to-string"],
      "@earendil-works/pi-ai": ["../../harness/pi/packages/ai/dist/index.d.ts"],
      "@mariozechner/pi-ai": ["../../harness/pi/packages/ai/dist/index.d.ts"],
      "@mariozechner/pi-agent-core": ["../../harness/pi/packages/agent/dist/index.d.ts"],
      "@earendil-works/pi-coding-agent": ["../../harness/pi/packages/coding-agent/dist/index.d.ts"],
      "@mariozechner/pi-coding-agent": ["../../harness/pi/packages/coding-agent/dist/index.d.ts"],
      "@earendil-works/pi-ai/compat": ["../../harness/pi/packages/ai/dist/compat.d.ts"]
    }
  },
  "include": [
    "conversation-state/**/*.ts",
    "session-actions/**/*.ts",
    "agent-connection/**/*.ts",
    "deferred-triggers/**/*.ts",
    "settings/**/*.ts",
    "file-changes/**/*.ts",
    "transcript-delivery/**/*.ts",
    "test/conversation-state/**/*.ts",
    "test/session-actions/**/*.ts",
    "test/agent-connection/**/*.ts",
    "test/deferred-triggers/**/*.ts",
    "test/settings/**/*.ts",
    "test/file-changes/**/*.ts",
    "test/transcript-delivery/**/*.ts",
    "test/helpers/**/*.ts",
    "composition/host-runtime.test.ts",
    "composition/completion-notification.test.ts",
    "../lib/validation/**/*.ts"
  ],
  "exclude": ["node_modules"]
}