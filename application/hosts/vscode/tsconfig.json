{
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/typecheck/extension.tsbuildinfo",
    "verbatimModuleSyntax": false,
    "target": "ES2021",
    "lib": [
      "ES2021",
      "ES2022.Error",
      "ES2022.Object",
      "DOM",
      "DOM.Iterable"
    ],
    "outDir": "./out",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": [
      "node",
      "vscode",
      "vite/client"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "baseUrl": ".",
    "paths": {
      "@earendil-works/pi-ai": [
        "../../../harness/pi/packages/ai/dist/index.d.ts"
      ],
      "@mariozechner/pi-ai": [
        "../../../harness/pi/packages/ai/dist/index.d.ts"
      ],
      "@earendil-works/pi-ai/compat": [
        "../../../harness/pi/packages/ai/dist/compat.d.ts"
      ],
      "@earendil-works/pi-coding-agent": [
        "../../../harness/pi/packages/coding-agent/dist/index.d.ts"
      ],
      "@mariozechner/pi-coding-agent": [
        "../../../harness/pi/packages/coding-agent/dist/index.d.ts"
      ],
      "yaml": [
        "./node_modules/yaml"
      ],
      "immer": [
        "./node_modules/immer"
      ],
      "preact": [
        "./node_modules/preact"
      ],
      "preact/*": [
        "./node_modules/preact/*"
      ],
      "preact-render-to-string": [
        "./node_modules/preact-render-to-string"
      ]
    }
  },
  "include": [
    "../../../harness/agent-instructions/**/*",
    "../../../application/frontend/**/*",
    "../../../application/hosts/**/*",
    "vite.config.ts",
    "../../../scripts/build/**/*.mjs"
  ],
  "exclude": [
    "node_modules",
    "out"
  ]
}
