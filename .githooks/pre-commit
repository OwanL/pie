#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

model_inputs=$(git diff --cached --name-only --diff-filter=ACMR -- models.yaml models.schema.json)
if [ -n "$model_inputs" ]; then
  if ! git diff --quiet -- models.yaml models.schema.json; then
    echo "pre-commit: models.yaml/models.schema.json has unstaged changes." >&2
    echo "Stage or discard them before committing so generated config matches the staged source." >&2
    exit 1
  fi

  echo "pre-commit: synchronizing generated model configuration..."
  npm run sync-models
  git add -- models.json model-profiles.yaml settings.json
fi

echo "pre-commit: running checks for changed files..."
npm run test:changed
