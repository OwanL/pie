{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pie/models.schema.json",
  "title": "pie models.yaml source",
  "type": "object",
  "additionalProperties": false,
  "required": ["defaults", "retry", "pruning", "proxy", "profileOrder", "providers"],
  "properties": {
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "provider", "thinkingLevel"],
      "properties": {
        "model": { "type": "string" },
        "provider": { "type": "string" },
        "thinkingLevel": { "$ref": "#/definitions/thinkingLevel" }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "maxRetries", "baseDelayMs", "provider"],
      "properties": {
        "enabled": { "type": "boolean" },
        "maxRetries": { "type": "integer", "minimum": 0 },
        "baseDelayMs": { "type": "integer", "minimum": 0 },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxRetries", "maxRetryDelayMs"],
          "properties": {
            "maxRetries": { "type": "integer", "minimum": 0 },
            "maxRetryDelayMs": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "pruning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "provider", "thinkingLevel"],
      "properties": {
        "model": { "type": "string" },
        "provider": { "type": "string" },
        "thinkingLevel": { "$ref": "#/definitions/thinkingLevel" }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routerSettings", "litellmSettings", "generalSettings"],
      "properties": {
        "routerSettings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["numRetries", "retryAfter", "timeout"],
          "properties": {
            "numRetries": { "type": "integer", "minimum": 0 },
            "retryAfter": { "type": "boolean" },
            "timeout": { "type": "integer", "minimum": 0 }
          }
        },
        "litellmSettings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dropParams"],
          "properties": {
            "dropParams": { "type": "boolean" }
          }
        },
        "generalSettings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["masterKeyEnv"],
          "properties": {
            "masterKeyEnv": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "profileOrder": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "providers": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/provider" }
    }
  },
  "definitions": {
    "thinkingLevel": {
      "type": "string",
      "enum": ["minimal", "low", "medium", "high", "xhigh", "off", "max", "none"]
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "cacheRead", "cacheWrite"],
      "properties": {
        "input": { "type": "number", "minimum": 0 },
        "output": { "type": "number", "minimum": 0 },
        "cacheRead": { "type": "number", "minimum": 0 },
        "cacheWrite": { "type": "number", "minimum": 0 }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiKey", "models"],
      "properties": {
        "baseUrl": { "type": "string" },
        "api": { "type": "string" },
        "apiKey": { "type": "string" },
        "compat": { "type": "object" },
        "headers": { "type": "object" },
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "required": ["apiBase", "apiKeyEnv", "litellmProvider", "maxConcurrentRequests", "litellmModelInfoId", "modelListOrder", "alias"],
          "properties": {
            "apiBase": { "type": "string" },
            "apiKeyEnv": { "type": "string", "minLength": 1 },
            "litellmProvider": { "type": "string" },
            "maxConcurrentRequests": { "type": "integer", "minimum": 1 },
            "litellmModelInfoId": { "type": "string" },
            "modelListOrder": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            },
            "alias": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "models": {
          "type": "array",
          "items": { "$ref": "#/definitions/model" }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "pricing", "eligible", "thinking", "disabledReason", "costRank"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "api": { "type": "string" },
        "compat": { "type": "object" },
        "reasoning": { "type": "boolean" },
        "family": { "type": "string" },
        "input": {
          "type": "array",
          "items": { "type": "string" }
        },
        "contextWindow": { "type": "integer", "minimum": 1 },
        "maxTokens": { "type": "integer", "minimum": 1 },
        "thinkingLevelMap": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "null" }
            ]
          }
        },
        "pricing": { "$ref": "#/definitions/pricing" },
        "overrideOnly": { "type": "boolean" },
        "eligible": { "type": "boolean" },
        "thinking": {
          "type": "array",
          "items": { "$ref": "#/definitions/thinkingLevel" }
        },
        "disabledReason": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "costRank": { "type": "integer", "minimum": 0 }
      }
    }
  }
}