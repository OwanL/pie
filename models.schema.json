{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pie/models.schema.json",
  "title": "pie models.yaml source",
  "type": "object",
  "additionalProperties": false,
  "required": ["defaults", "retry", "pruning", "sessionTitles", "profileOrder", "providers"],
  "properties": {
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "provider", "thinkingLevel"],
      "properties": {
        "model": { "type": "string" },
        "provider": { "type": "string" },
        "thinkingLevel": { "$ref": "#/definitions/thinkingLevel" }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "maxRetries", "baseDelayMs", "provider"],
      "properties": {
        "enabled": { "type": "boolean" },
        "maxRetries": { "type": "integer", "minimum": 0 },
        "baseDelayMs": { "type": "integer", "minimum": 0 },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxRetries", "maxRetryDelayMs"],
          "properties": {
            "maxRetries": { "type": "integer", "minimum": 0 },
            "maxRetryDelayMs": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "pruning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "provider", "thinkingLevel"],
      "properties": {
        "model": { "type": "string" },
        "provider": { "type": "string" },
        "thinkingLevel": { "$ref": "#/definitions/thinkingLevel" }
      }
    },
    "sessionTitles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "model", "provider", "thinkingLevel", "timeoutSec"],
      "properties": {
        "enabled": { "type": "boolean" },
        "model": { "type": "string", "minLength": 1 },
        "provider": { "type": "string", "minLength": 1 },
        "thinkingLevel": { "$ref": "#/definitions/thinkingLevel" },
        "timeoutSec": { "type": "integer", "minimum": 1, "maximum": 60 }
      }
    },
    "profileOrder": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "id"],
            "properties": {
              "provider": { "type": "string", "minLength": 1 },
              "id": { "type": "string", "minLength": 1 }
            }
          }
        ]
      },
      "uniqueItems": true
    },
    "providers": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/provider" }
    },
    "historicalModels": {
      "type": "array",
      "items": { "$ref": "#/definitions/historicalModel" }
    }
  },
  "definitions": {
    "thinkingLevel": {
      "type": "string",
      "enum": ["minimal", "low", "medium", "high", "xhigh", "off", "max", "none"]
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "cacheRead", "cacheWrite"],
      "properties": {
        "input": { "type": "number", "minimum": 0 },
        "output": { "type": "number", "minimum": 0 },
        "cacheRead": { "type": "number", "minimum": 0 },
        "cacheWrite": { "type": "number", "minimum": 0 },
        "tiers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["inputTokensAbove", "input", "output", "cacheRead", "cacheWrite"],
            "properties": {
              "inputTokensAbove": { "type": "number", "minimum": 0 },
              "input": { "type": "number", "minimum": 0 },
              "output": { "type": "number", "minimum": 0 },
              "cacheRead": { "type": "number", "minimum": 0 },
              "cacheWrite": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiKey", "models"],
      "properties": {
        "baseUrl": { "type": "string" },
        "api": { "type": "string" },
        "apiKey": { "type": "string" },
        "compat": { "type": "object" },
        "headers": { "type": "object" },
        "concurrency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxConcurrentRequests"],
          "properties": {
            "maxConcurrentRequests": { "type": "integer", "minimum": 1 },
            "afterburnSeconds": { "type": "number", "minimum": 0 },
            "queueWaitSeconds": { "type": "number", "minimum": 0 },
            "headerWaitSeconds": { "type": "number", "minimum": 0 }
          }
        },
        "models": {
          "type": "array",
          "items": { "$ref": "#/definitions/model" }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "pricing", "eligible", "thinking", "disabledReason"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "api": { "type": "string" },
        "compat": { "type": "object" },
        "reasoning": { "type": "boolean" },
        "family": { "type": "string" },
        "input": {
          "type": "array",
          "items": { "enum": ["text", "image"] }
        },
        "maxImagesPerRequest": { "type": "integer", "minimum": 1 },
        "contextWindow": { "type": "integer", "minimum": 1 },
        "maxTokens": { "type": "integer", "minimum": 1 },
        "thinkingLevelMap": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "null" }
            ]
          }
        },
        "pricing": { "$ref": "#/definitions/pricing" },
        "overrideOnly": { "type": "boolean" },
        "eligible": { "type": "boolean" },
        "thinking": {
          "type": "array",
          "items": { "$ref": "#/definitions/thinkingLevel" }
        },
        "disabledReason": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        }
      }
    },
    "historicalModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "id", "name", "pricing"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "family": { "type": "string" },
        "pricing": { "$ref": "#/definitions/pricing" }
      }
    }
  }
}
