{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:pie:provider-config:v1",
  "title": "Pie provider configuration v1 (not production-wired)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "providers"],
  "properties": {
    "version": { "const": 1 },
    "providers": {
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/id" },
      "additionalProperties": { "$ref": "#/definitions/provider" }
    }
  },
  "definitions": {
    "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "rate": { "type": "number", "minimum": 0 },
    "tier": {
      "type": "object", "additionalProperties": false,
      "required": ["inputTokensAbove", "input", "output", "cacheRead", "cacheWrite"],
      "properties": {
        "inputTokensAbove": { "$ref": "#/definitions/rate" },
        "input": { "$ref": "#/definitions/rate" },
        "output": { "$ref": "#/definitions/rate" },
        "cacheRead": { "$ref": "#/definitions/rate" },
        "cacheWrite": { "$ref": "#/definitions/rate" }
      }
    },
    "pricing": {
      "description": "Explicit unknown or USD per million tokens; zero is a known rate.",
      "oneOf": [
        { "const": "unknown" },
        {
          "type": "object", "additionalProperties": false, "required": ["input", "output"],
          "properties": {
            "input": { "$ref": "#/definitions/rate" },
            "output": { "$ref": "#/definitions/rate" },
            "cacheRead": { "$ref": "#/definitions/rate" },
            "cacheWrite": { "$ref": "#/definitions/rate" },
            "tiers": { "type": "array", "items": { "$ref": "#/definitions/tier" } }
          }
        }
      ]
    },
    "override": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/definitions/id" },
        "input": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["text", "image"] } },
        "reasoning": { "type": "boolean" },
        "contextWindow": { "type": "integer", "minimum": 1 },
        "maxTokens": { "type": "integer", "minimum": 1 },
        "pricing": { "$ref": "#/definitions/pricing" }
      }
    },
    "preferences": {
      "type": "object", "additionalProperties": false,
      "properties": { "visible": { "type": "boolean" }, "subagentEligible": { "type": "boolean" } }
    },
    "credentialRef": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["source"], "properties": { "source": { "const": "saved" } } },
        { "type": "object", "additionalProperties": false, "required": ["source"], "properties": { "source": { "const": "none" } } },
        { "type": "object", "additionalProperties": false, "required": ["source", "name"], "properties": { "source": { "const": "environment" }, "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } } }
      ]
    },
    "provider": {
      "type": "object", "additionalProperties": false, "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "baseUrl": { "type": "string", "pattern": "^https?://[^\\s/?#]+(?:[^\\s]*)$" },
        "api": { "enum": ["openai-completions", "mistral-conversations", "openai-responses", "azure-openai-responses", "openai-codex-responses", "anthropic-messages", "bedrock-converse-stream", "google-generative-ai", "google-vertex"] },
        "credentialRef": { "$ref": "#/definitions/credentialRef" },
        "manualModels": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
        "modelOverrides": { "type": "object", "propertyNames": { "$ref": "#/definitions/id" }, "additionalProperties": { "$ref": "#/definitions/override" } },
        "modelPreferences": { "type": "object", "propertyNames": { "$ref": "#/definitions/id" }, "additionalProperties": { "$ref": "#/definitions/preferences" } }
      }
    }
  }
}
