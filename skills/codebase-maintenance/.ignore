# Canonical ignore file for codebase-maintenance scans.
#
# Patterns before any `context` line apply to every scan root.
# Patterns after `context <working-directory>` apply only when the directory
# passed to the scan script matches that working-directory suffix or glob.
#
# Ignore patterns are relative to the scan root.
# - `cache/` ignores any directory named `cache` at any depth.
# - `*.generated.ts` ignores matching files anywhere in the scan.
# - `*/__pycache__` ignores matching directories via glob.
#
# Example:
# context */pi-config/
# analysis/data/exports/
# *.generated.ts

# --- Dependencies ---
node_modules/
.venv/
venv/
.pnpm-store/
# --- Version control ---
.git/
# --- Generated / build output ---
out/
out-tsc/
dist/
build/
.next/
.turbo/
.moon/
# --- Caches ---
.cache/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.temp/
.tmp/
.parcel-cache/
.skylos/
web-search-cache/
mcp-cache.json
# --- Coverage ---
coverage/
.nyc_output/
# --- Runtime data (multi-gigabyte pi runtime artifacts) ---
data/
analysis/data/
pie/
bin/
npm/
proxy/.venv/
proxy/.uv-cache/
# --- Session transcripts / per-session workspaces ---
sessions/
# --- Logs ---
logs/
*.log
# --- Packaged / test-run artifacts ---
.vscode-test/
test-results/
playwright-report/
*.egg-info/
# --- Temporary SDK test worktrees (may survive interrupted runs) ---
extension/.pie-sdk-*/

analysis/site/dist/
skills/codebase-maintenance/
extension/test/_helpers/
extension/test/fixtures/
*.min.js
*.bundle.*
*.chunk.*
*.generated.*
*.d.mts
*.pb.*
*_pb2.py
*_pb2_grpc.py
