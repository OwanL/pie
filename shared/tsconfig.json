{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2021",
    "lib": ["ES2021"],
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "../node_modules/.cache/typecheck/shared.tsbuildinfo",
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["../node_modules/@types", "../application/hosts/vscode/node_modules/@types"]
  },
  "include": ["./**/*.ts"]
}