{
  "defaultModel": "glm-5.2:cloud",
  "defaultThinkingLevel": "high",
  "defaultProvider": "ollama",
  "retry": {
    "enabled": true,
    "maxRetries": 8,
    "baseDelayMs": 5000,
    "provider": {
      "maxRetries": 2,
      "maxRetryDelayMs": 60000
    }
  },
  "httpIdleTimeoutMs": 0,
  "bashDefaultTimeout": 60,
  "packages": [
    "npm:pi-web-access@0.13.0",
    "npm:pi-mcp-adapter@2.20.1"
  ],
  "pruning": {
    "model": "gpt-5-mini",
    "provider": "github-copilot",
    "thinkingLevel": "low",
    "prepass": {
      "temperature": 0.2
    },
    "skills": {
      "strategy": "discretion",
      "ceiling": 5
    },
    "tools": {
      "strategy": "discretion",
      "ceiling": 10,
      "alwaysKeep": [
        "bash",
        "edit",
        "read",
        "write",
        "mcp"
      ]
    },
    "autoSkipBelowTokens": null
  },
  "toolResultPruning": {
    "enabled": true,
    "profile": "default"
  },
  "subagent": {
    "confirmProjectAgents": false
  },
  "sessionDir": "data/outcomes/sessions"
}
