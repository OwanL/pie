{
  "name": "pi-config",
  "private": true,
  "engines": {
    "node": ">=24.16.0",
    "npm": ">=11.13.0"
  },
  "packageManager": "npm@11.13.0",
  "//workspaces": "npm workspaces are intentionally NOT enabled. Extension packages are loaded directly by pi and verified by the root test/typecheck runners. Activating workspaces would require package.json files for every extension and would change root dependency installation.",
  "scripts": {
    "postinstall": "node ./scripts/install-dependencies.mjs && node ./scripts/install-git-hooks.mjs",
    "install:dependencies": "node ./scripts/install-dependencies.mjs",
    "hooks:install": "node ./scripts/install-git-hooks.mjs",
    "test": "node ./scripts/run-tests.mjs",
    "test:fast": "node ./scripts/run-tests.mjs --fast",
    "test:file": "node ./scripts/run-test-files.mjs",
    "test:changed": "node ./scripts/run-changed-tests.mjs",
    "test:scripts": "node ./scripts/run-tests.mjs --fast --package scripts",
    "shared:typecheck": "node ./scripts/run-typechecks.mjs --project shared",
    "typecheck": "node ./scripts/run-typechecks.mjs",
    "check": "npm run sync-models -- --check && npm run typecheck && npm --prefix extension run lint -- && npm run test:changed",
    "verify": "npm run sync-models -- --check && npm run typecheck && npm --prefix extension run lint -- && npm run test && npm run extension:build:after-typecheck",
    "analytics:typecheck": "npm --prefix analysis run typecheck --",
    "analytics:test": "node ./scripts/run-tests.mjs --package analysis",
    "analytics:build-db": "npm --prefix analysis run build-db --",
    "analytics:query": "npm --prefix analysis run query --",
    "analytics:export-site-data": "npm --prefix analysis run export-site-data --",
    "analytics:validate-site-data": "npm --prefix analysis run validate-site-data --",
    "analytics:build-site": "npm --prefix analysis run build-site --",
    "analytics:serve": "npm --prefix analysis run serve --",
    "analytics:validate": "npm --prefix analysis run validate --",
    "bootstrap": "node ./scripts/bootstrap.mjs",
    "doctor": "node ./scripts/doctor.mjs",
    "extension:build": "npm --prefix extension run build --",
    "extension:build:after-typecheck": "npm --prefix extension run build -- --skip-typecheck --no-sync",
    "extension:test": "node ./scripts/run-tests.mjs --package extension",
    "extension:typecheck": "node ./scripts/run-typechecks.mjs --project extension",
    "extensions:test": "node ./scripts/run-tests.mjs --package ask-user --package copilot-model-discovery --package cwd-skills --package safeguard --package skill-pruner --package subagent --package web-access-compat --package warm-bash --package tool-result-pruner --package session-reviewer --package session-changes --package deferred-triggers",
    "extensions:typecheck": "node ./scripts/run-typechecks.mjs --project ask-user --project copilot-model-discovery --project cwd-skills --project safeguard --project skill-pruner --project web-access-compat --project warm-bash --project tool-result-pruner --project session-reviewer --project session-changes --project deferred-triggers",
    "experiment:create": "node ./scripts/experiments/cli.mjs create",
    "experiment:status": "node ./scripts/experiments/cli.mjs status",
    "experiment:watch": "node ./scripts/experiments/cli.mjs watch",
    "experiment:materialize": "node ./scripts/experiments/cli.mjs materialize",
    "experiment:capture": "node ./scripts/experiments/cli.mjs capture",
    "experiment:resume": "node ./scripts/experiments/cli.mjs resume",
    "experiment:smoke": "node ./scripts/experiments/cli.mjs smoke",
    "experiment:run": "node ./scripts/experiments/cli.mjs run",
    "experiment:compare": "node ./scripts/experiments/cli.mjs compare",
    "experiment:clean": "node ./scripts/experiments/cli.mjs clean",
    "experiment:test": "node --test scripts/experiments/test/*.test.mjs",
    "experiment:image:build": "node --input-type=module -e \"import('./scripts/experiments/lib/container-runtime.mjs').then(m=>console.log(m.buildContainerImage()))\"",
    "experiment:calibrate": "node ./scripts/experiments/calibrate.mjs",
    "sync-models": "node ./scripts/sync-models.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "gpt-tokenizer": "^3.4.0",
    "tsx": "^4.22.3"
  },
  "overrides": {
    "esbuild": ">=0.28.1"
  }
}
