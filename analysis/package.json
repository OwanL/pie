{
  "name": "pie-analysis",
  "private": true,
  "type": "module",
  "description": "Standalone local analytics transforms and DuckDB queries for pie run analytics.",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node ../scripts/run-tests.mjs --fast --package analysis",
    "build-db": "tsx ./scripts/build-db.ts",
    "query": "tsx ./scripts/query.ts",
    "validate": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.2-r.1"
  },
  "devDependencies": {
    "@types/node": "25.7.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3"
  }
}
