# PI local runtime data and auth files
auth.json
auth.json.*
*.auth.json
/data/

# Legacy repo-local PI runtime dirs kept ignored for compatibility
# (root /pie/ is old local runtime data, not the tracked VS Code extension source under /extension/)
/sessions/
/pie/

# Legacy local export drop locations kept ignored for compatibility
/run-analytics-export.json

# Environment files
.env
.env.*
*.env

# PI-managed binaries and package caches
/bin/
/git/
/npm/

# Package manager artifacts
node_modules/
.pnpm-store/
.pnpm-debug.log

# LiteLLM proxy (pie/proxy/) — uv venv + runtime data
proxy/.venv/
proxy/.uv-cache/
data/proxy/

# Note: keep lockfiles (package-lock.json, yarn.lock, pnpm-lock.yaml) tracked

# Package build artifacts
/extension/out/
/extension/qualitas-report.json
/extension/.qualitas.config.js
/extension/src/-
/analysis/site/dist/
*.vsix

# Build / test caches
__pycache__/
*.pyc
coverage/
.nyc_output/
*.tsbuildinfo
out-tsc/
.tmp/
.temp/
.cache/
.parcel-cache/
.eslintcache
.skylos/

# Stale TypeScript emit alongside source (build outputs to /extension/out/)
extension/src/**/*.js
extension/src/**/*.js.map
extension/test/*.js
extension/test/*.js.map
extension/test/perf/reports/
extension/test-results/

# Analysis package generated outputs
/analysis/data/*.duckdb
/analysis/data/*.duckdb.*
/analysis/data/exports/
/analysis/data/tmp-site-data/
/analysis/site/data/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS artifacts
Thumbs.db
.DS_Store
desktop.ini
ehthumbs.db
# Windows null-device artifacts. Git's ignore matching is case-insensitive on
# Windows, but ripgrep's traversal is not reliably so; list both spellings.
nul
NUL

# Editor / IDE artifacts
*.swp
*.swo
.idea/
.vscode-test/
# NOTE: this repo keeps a committed .vscode/ (workspace settings/tasks/extensions).
# If you want to ignore all local VS Code state, uncomment the next line:
# .vscode/

# Installer-generated backups and transient cross-process settings lock
/settings.json.session-dir.*.bak
/settings.json.extensions.*.bak
/settings.json.pie-lock
.skylos/cache/grep_results.json
