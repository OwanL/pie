{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "typescript.preferences.quoteStyle": "single",
  "javascript.preferences.quoteStyle": "single",
  "github.copilot.chat.claudeAgent.allowDangerouslySkipPermissions": true,
  // pie.sdkPath and PI_SDK_PATH are not runtime selectors. Production uses
  // the verified pi-runtime bundled with the selected delivery; development
  // uses the explicitly selected local workspace SDK. See README.md.
  // Do not commit absolute, username-scoped runtime paths here.
  // Hide PI runtime artifacts from the explorer
  "files.exclude": {
    "data/": true,
    "auth.json": true,
    "application/hosts/vscode/node_modules/": true,
    "application/hosts/vscode/out/": true,
    "bin/": true,
    "git/": true,
    "npm/": true
  }
}
