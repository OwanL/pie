{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "typescript.preferences.quoteStyle": "single",
  "javascript.preferences.quoteStyle": "single",
  "github.copilot.chat.claudeAgent.allowDangerouslySkipPermissions": true,
  // pie.sdkPath is intentionally NOT set here. The extension auto-resolves
  // the SDK via `npm root -g` (falling back to PI_SDK_PATH env then a cached
  // path) — see extension/src/shared/runtime-resolution.ts. Committing an
  // absolute, username-scoped path here breaks every other machine on pull.
  // To pin a non-standard SDK location, set pie.sdkPath in VS Code *User*
  // settings (per-machine), or set PI_SDK_PATH.
  // Hide PI runtime artifacts from the explorer
  "files.exclude": {
    "data/": true,
    "auth.json": true,
    "bin/": true,
    "git/": true,
    "npm/": true
  }
}
