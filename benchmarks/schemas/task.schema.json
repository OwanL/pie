{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pie.local/schemas/task.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "promptFile", "fixture", "policy", "limits", "checks", "metrics"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "promptFile": {"type": "string"},
    "fixture": {
      "type": "object",
      "required": ["type", "path"],
      "properties": {"type": {"const": "directory"}, "path": {"type": "string"}}
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validArtifact"],
      "properties": {
        "validArtifact": {"type": "string", "minLength": 1}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extensions": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "description", "path"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "description": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "required": ["network", "subagents", "allowedTools", "allowedChangedPaths"],
      "properties": {
        "network": {"const": "deny"},
        "subagents": {"const": "deny"},
        "allowedTools": {"type": "array", "items": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"}},
        "allowedChangedPaths": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "limits": {"type": "object", "required": ["timeoutMs", "checkTimeoutMs", "scorerTimeoutMs", "maxBashTimeoutSeconds"], "properties": {"timeoutMs": {"type": "integer", "minimum": 1000}, "checkTimeoutMs": {"type":"integer","minimum":1000,"maximum":60000}, "scorerTimeoutMs": {"type":"integer","minimum":1000,"maximum":30000}, "maxBashTimeoutSeconds": {"type":"integer","minimum":1,"maximum":300}}},
    "checks": {
      "type": "object",
      "required": ["public", "privateScorer"],
      "properties": {
        "privateScorer": {"type": "string"},
        "public": {
          "type": "array",
          "items": {
            "oneOf": [
              {"type": "string"},
              {"type": "object", "required": ["script"], "properties": {"script": {"type": "string"}}}
            ]
          }
        }
      }
    },
    "metrics": {"type": "object"}
  }
}
