{
  "schemaVersion": 1,
  "id": "vector-shard-rebalancer",
  "version": 6,
  "promptFile": "prompt.md",
  "fixture": {
    "type": "directory",
    "path": "fixture"
  },
  "policy": {
    "network": "deny",
    "subagents": "deny",
    "allowedTools": [
      "read",
      "edit",
      "write",
      "bash",
      "grep",
      "find",
      "ls"
    ],
    "allowedChangedPaths": [
      "src/rebalance.mjs"
    ]
  },
  "limits": {
    "timeoutMs": 3600000,
    "checkTimeoutMs": 30000,
    "scorerTimeoutMs": 10000,
    "maxBashTimeoutSeconds": 60
  },
  "checks": {
    "public": [
      "npm test",
      "npm run benchmark -- --json"
    ],
    "privateScorer": "../../scorers/private/vector-shard-rebalancer.mjs"
  },
  "metrics": {
    "primary": "normalizedQuality",
    "secondary": [
      "peakUtilization",
      "migrationCost",
      "violations",
      "outputTokens"
    ]
  }
}
