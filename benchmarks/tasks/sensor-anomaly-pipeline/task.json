{
  "schemaVersion": 1,
  "id": "sensor-anomaly-pipeline",
  "version": 8,
  "promptFile": "prompt.md",
  "fixture": {
    "type": "directory",
    "path": "fixture"
  },
  "policy": {
    "network": "deny",
    "subagents": "deny",
    "allowedTools": [
      "read",
      "edit",
      "write",
      "bash",
      "grep",
      "find",
      "ls"
    ],
    "allowedChangedPaths": [
      "src/model.mjs"
    ]
  },
  "limits": {
    "timeoutMs": 3600000,
    "checkTimeoutMs": 30000,
    "scorerTimeoutMs": 10000,
    "maxBashTimeoutSeconds": 60
  },
  "checks": {
    "public": [
      "npm test",
      "npm run evaluate -- --json"
    ],
    "privateScorer": "../../scorers/private/sensor-anomaly-pipeline.mjs"
  },
  "metrics": {
    "primary": "balancedAccuracy",
    "secondary": [
      "sensitivity",
      "specificity",
      "runtimeMs",
      "outputTokens"
    ]
  }
}
