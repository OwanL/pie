{
  "schemaVersion": 1,
  "id": "feature-cache-planner",
  "version": 5,
  "promptFile": "prompt.md",
  "fixture": {
    "type": "directory",
    "path": "fixture"
  },
  "policy": {
    "network": "deny",
    "subagents": "deny",
    "allowedTools": [
      "read",
      "edit",
      "write",
      "bash",
      "grep",
      "find",
      "ls"
    ],
    "allowedChangedPaths": [
      "src/planner.mjs"
    ]
  },
  "limits": {
    "timeoutMs": 900000,
    "checkTimeoutMs": 30000,
    "scorerTimeoutMs": 10000,
    "maxBashTimeoutSeconds": 60
  },
  "checks": {
    "public": [
      "npm test",
      "npm run benchmark -- --json"
    ],
    "privateScorer": "../../scorers/private/feature-cache-planner.mjs"
  },
  "metrics": {
    "primary": "normalizedQuality",
    "secondary": [
      "savedCompute",
      "freshnessPenalty",
      "usedBytes",
      "outputTokens"
    ]
  }
}
