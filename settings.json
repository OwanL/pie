{
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "high",
  "defaultProvider": "github-copilot",
  "retry": {
    "enabled": true,
    "maxRetries": 8,
    "baseDelayMs": 5000,
    "provider": {
      "maxRetries": 2,
      "maxRetryDelayMs": 60000
    }
  },
  "httpIdleTimeoutMs": 0,
  "bashDefaultTimeout": 60,
  "packages": [
    "npm:pi-web-access@0.13.0"
  ],
  "pruning": {
    "model": "deepseek-v4-flash:0731-cloud",
    "provider": "ollama",
    "thinkingLevel": "off",
    "prepass": {
      "temperature": 0.2,
      "maxOutputTokens": 1024,
      "timeoutMs": {
        "minimal": 15000,
        "low": 15000,
        "medium": 15000,
        "high": 15000,
        "xhigh": 15000
      },
      "maxTransportRetries": 0
    },
    "skills": {
      "strategy": "discretion",
      "ceiling": 5
    },
    "tools": {
      "strategy": "discretion",
      "ceiling": 10,
      "alwaysKeep": [
        "bash",
        "edit",
        "read",
        "write",
        "subagent",
        "ask_user"
      ]
    },
    "autoSkipBelowTokens": null
  },
  "toolResultPruning": {
    "enabled": true,
    "profile": "default"
  },
  "lastChangelogVersion": "0.80.2",
  "subagent": {
    "confirmProjectAgents": false
  },
  "sessionDir": "data/outcomes/sessions"
}
