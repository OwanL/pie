{
  "defaultModel": "gpt-5.6-terra",
  "defaultThinkingLevel": "medium",
  "defaultProvider": "openai-codex",
  "retry": {
    "enabled": true,
    "maxRetries": 8,
    "baseDelayMs": 5000,
    "provider": {
      "maxRetries": 2,
      "maxRetryDelayMs": 60000
    }
  },
  "httpIdleTimeoutMs": 0,
  "bashDefaultTimeout": 60,
  "packages": [
    "npm:pi-web-access@0.13.0"
  ],
  "pruning": {
    "model": "gpt-5.4-mini",
    "provider": "openai-codex",
    "thinkingLevel": "low",
    "prepass": {
      "temperature": 0.2
    },
    "skills": {
      "strategy": "discretion",
      "ceiling": 5
    },
    "tools": {
      "strategy": "discretion",
      "ceiling": 10,
      "alwaysKeep": [
        "bash",
        "edit",
        "read",
        "write",
        "subagent",
        "ask_user"
      ]
    },
    "autoSkipBelowTokens": null
  },
  "toolResultPruning": {
    "enabled": true,
    "profile": "default"
  },
  "lastChangelogVersion": "0.80.2",
  "subagent": {
    "confirmProjectAgents": false
  },
  "sessionDir": "data/outcomes/sessions"
}