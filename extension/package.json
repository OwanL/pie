{
  "name": "pie",
  "displayName": "pie",
  "description": "Native PI coding agent chat and session UI for VSCode",
  "version": "0.3.0",
  "publisher": "pie",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:pie.openChat",
    "onCommand:pie.newSession",
    "onCommand:pie.restartBackend",
    "onCommand:pie.exportRunAnalytics",
    "onView:pie.sessionsView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pie",
          "title": "pie",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "pie": [
        {
          "type": "webview",
          "id": "pie.sessionsView",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "pie.openChat",
        "title": "pie: Open Chat"
      },
      {
        "command": "pie.newSession",
        "title": "pie: New Session"
      },
      {
        "command": "pie.attachFiles",
        "title": "pie: Attach Selected Files"
      },
      {
        "command": "pie.restartBackend",
        "title": "pie: Restart Backend"
      },
      {
        "command": "pie.exportRunAnalytics",
        "title": "pie: Export Run Analytics"
      },
      {
        "command": "pie.toggleStreamDiag",
        "title": "pie: Toggle Stream Diagnostics"
      },
      {
        "command": "pie.setLogLevel",
        "title": "pie: Set Log Level"
      },
      {
        "command": "pie.openLogFile",
        "title": "pie: Open Log File"
      },
      {
        "command": "pie.revealLogFolder",
        "title": "pie: Reveal Log Folder"
      },
      {
        "command": "pie.dumpDebugState",
        "title": "pie: Dump Debug State"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "pie.attachFiles",
          "when": "resourceScheme == file",
          "group": "navigation@100"
        }
      ]
    },
    "configuration": {
      "title": "pie",
      "properties": {
        "pie.nodePath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the standalone Node.js executable used to run the PI backend. It must satisfy the installed PI SDK's declared Node engine requirement; when empty, Pie selects the first compatible Node executable on PATH."
        },
        "pie.sdkPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the installed PI SDK package directory, such as @earendil-works/pi-coding-agent."
        },
        "pie.agentDir": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the pi agent directory that contains settings.json and models.json. Forwarded to the backend as PI_CODING_AGENT_DIR. Validated on startup: if this path no longer exists or lacks settings.json, the PI_CODING_AGENT_DIR env var and the extension's parent directory are tried as fallbacks (a warning is shown). If empty, the environment variable PI_CODING_AGENT_DIR is used as a fallback."
        },
        "pie.experimentAssignment": {
          "type": "string",
          "default": "",
          "description": "Optional experiment/treatment assignment label recorded on new run analytics snapshots."
        },
        "pie.allowInTreeAuth": {
          "type": "boolean",
          "default": false,
          "description": "Allow loading auth credentials from inside a Git working tree."
        },
        "pie.logLevel": {
          "type": "string",
          "enum": ["trace", "debug", "info", "warn", "error"],
          "default": "info",
          "enumDescriptions": [
            "Very verbose: include every log call site. High volume.",
            "Verbose: include stream-telemetry snapshots and other diagnostic detail.",
            "Default: informational, warnings, and errors.",
            "Warnings and errors only.",
            "Errors only."
          ],
          "description": "Minimum verbosity for pie's host-side logger (the `pie` OutputChannel, the persistent log file in the OS temp dir, and the extension-host console). Raising this surfaces existing debug/trace instrumentation (e.g. stream-telemetry snapshots) without restarting. Can also be changed live via the `pie: Set Log Level` command."
        },
        "pie.tempLogRetention": {
          "type": "object",
          "default": { "maxAgeDays": 7, "maxTotalSizeMb": 500 },
          "properties": {
            "maxAgeDays": { "type": "number", "default": 7, "minimum": 0, "description": "Delete orphaned pi tool-output temp logs (pi-bash-*.log / pi-output-*.log) older than this many days. 0 disables age-based deletion." },
            "maxTotalSizeMb": { "type": "number", "default": 500, "minimum": 0, "description": "After age-based deletion, evict the oldest temp logs until the combined size of survivors is under this cap (MB). 0 disables the size cap." }
          },
          "description": "Retention for orphaned pi tool-output temp logs the SDK writes on truncation but never cleans up. Reaped best-effort on extension activation."
        }
      }
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:webview": "vite build",
    "watch": "node ./scripts/build.mjs --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:ask-user": "tsc --noEmit -p ../extensions/ask-user/tsconfig.json",
    "typecheck:cwd-skills": "tsc --noEmit -p ../extensions/cwd-skills/tsconfig.json",
    "typecheck:safeguard": "tsc --noEmit -p ../extensions/safeguard/tsconfig.json",
    "typecheck:skill-pruner": "tsc --noEmit -p ../extensions/skill-pruner/tsconfig.json",
    "typecheck:web-access-compat": "tsc --noEmit -p ../extensions/web-access-compat/tsconfig.json",
    "typecheck:warm-bash": "tsc --noEmit -p ../extensions/warm-bash/tsconfig.json",
    "typecheck:tool-result-pruner": "tsc --noEmit -p ../extensions/tool-result-pruner/tsconfig.json",
    "typecheck:session-reviewer": "tsc --noEmit -p ../extensions/session-reviewer/tsconfig.json",
    "typecheck:session-changes": "tsc --noEmit -p ../extensions/session-changes/tsconfig.json",
    "typecheck:deferred-triggers": "tsc --noEmit -p ../extensions/deferred-triggers/tsconfig.json",
    "typecheck:computer-use": "tsc --noEmit -p ../extensions/computer-use/tsconfig.json",
    "typecheck:image-context-guard": "tsc --noEmit -p ../extensions/image-context-guard/tsconfig.json",
    "test": "node ../scripts/run-tests.mjs --fast --package extension",
    "perf": "tsx ./test/perf/streaming-pipeline.perf.ts",
    "perf:analytics": "tsx ./test/perf/analytics.perf.ts",
    "prepackage": "npm run build -- --no-sync",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/virtual-core": "^3.14.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.0.0",
    "ajv": "^8.20.0",
    "dompurify": "^3.2.6",
    "eslint": "^9.27.0",
    "globals": "^16.1.0",
    "happy-dom": "^20.9.0",
    "jsdom": "^26.1.0",
    "marked": "^15.0.12",
    "postcss": "^8.5.15",
    "preact": "^10.29.1",
    "preact-render-to-string": "^6.6.7",
    "react": "file:./shims/react",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.3",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.32.0",
    "use-undo": "^1.2.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.6",
    "gpt-tokenizer": "^3.4.0",
    "highlight.js": "^11.11.1",
    "immer": "^11.1.8",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "esbuild": ">=0.28.1"
  }
}
